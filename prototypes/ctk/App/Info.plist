	<string>The prototype's long-poll check connects to a test server on this network.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>The prototype stores a test item that needs Face ID to read.</string>
	<key>NFCReaderUsageDescription</key>
	<string>The prototype's optional iOS 26 check reads a YubiKey over NFC.</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A000000308</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
