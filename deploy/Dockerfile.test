# syntax=docker/dockerfile:1.7
# Test tooling: the headless approver, gate client and fixture generator, plus the PKCS#11
# provider and the third-party callers the milestone 3 gate uses (pkcs11-tool, OpenSSL 3
# with pkcs11-provider, OpenSSH).
FROM rust:1.93-bookworm AS build
WORKDIR /src
# relay-pcsc (the approver's --pcsc mode) links libpcsclite.
RUN apt-get update && apt-get install -y --no-install-recommends libpcsclite-dev \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,id=relay-gnu-target \
    cargo build --release --locked -p relay-test-approver -p relay-pkcs11 \
 && cp target/release/relay-test-approver /usr/local/bin/ \
 && cp target/release/librelay_pkcs11.so /librelay_pkcs11.so

# Built on bookworm (glibc 2.36); runs on trixie for pkcs11-provider 1.x.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libpcsclite1 opensc openssl pkcs11-provider openssh-client openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 tester \
 && usermod -p '*' tester \
 && mkdir -p /fixtures /run/sshd && chown tester:tester /fixtures
COPY --from=build /usr/local/bin/relay-test-approver /usr/local/bin/
COPY --from=build /librelay_pkcs11.so /usr/lib/pkcs11/librelay_pkcs11.so
COPY deploy/relay-pkcs11.module /usr/share/p11-kit/modules/relay-pkcs11.module
COPY tests/ /tests/
USER tester
ENTRYPOINT ["relay-test-approver"]
